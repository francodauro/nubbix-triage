# =====================================================================
# Copiá este archivo como ".env" y completá tus claves.
# El archivo .env NUNCA se sube al repo (está en .gitignore).
# Fuente: M0L2 (python-dotenv, ".env nunca va al repo") y consigna del PI
# (".env.example con variables documentadas, nunca credenciales reales").
# =====================================================================

# --- Proveedor primario (gratuito): Google Gemini --------------------
# Clave gratuita en https://aistudio.google.com  (botón "Get API key").
# IMPORTANTE: no actives facturación (billing) en ese proyecto de Google,
# así se queda en el plan gratuito y nunca cobra.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Los modelos Gemini pueden "pensar" antes de responder y esos tokens
# cuentan contra este límite; por eso es más alto que el de OpenAI.
GEMINI_MAX_TOKENS=1024

# --- Proveedor de respaldo (pago, económico): OpenAI -----------------
# Clave en https://platform.openai.com/api-keys
OPENAI_API_KEY=
# gpt-6-luna: USD 0.10 / 1M tokens de entrada, USD 0.50 / 1M de salida.
# Reemplaza a gpt-4.1-nano (tabla de M1L1), que OpenAI dio de baja.
OPENAI_MODEL=gpt-6-luna
# Se envía como max_completion_tokens.
OPENAI_MAX_TOKENS=200
# gpt-6-luna es un modelo de razonamiento: "none" = no razona (más barato y
# rápido; para clasificar alcanza). Dejarlo vacío para modelos que no razonan.
OPENAI_REASONING_EFFORT=none

# --- Comportamiento de la llamada (M1L1: Sampling) -------------------
# Clasificar no es creativo: temperature baja (0.0-0.2) en M1L1.
LLM_TEMPERATURE=0.0
# Orden de proveedores: el primero es el primario, el segundo el fallback.
LLM_PROVIDER_ORDER=gemini,openai

# --- Reintentos (M1L1: Rate limits y manejo de errores) --------------
LLM_MAX_RETRIES=2
# Si el proveedor pide esperar (Retry-After) más que esto, no esperamos:
# pasamos directo al proveedor de respaldo.
LLM_MAX_WAIT_SECONDS=10
LLM_TIMEOUT_SECONDS=30

# --- Presupuesto (M1L1: "gestionar el presupuesto de uso de API") ----
# Tope de gasto acumulado del proveedor pago para todo el curso.
# Objetivo del alumno: menos de USD 5 en 4 meses -> margen de seguridad.
BUDGET_USD=4.50

# --- Prompt (M1L2: prompts versionados en prompts/*.yaml) ------------
# Versión por defecto de la CLI: triage_v1 … triage_v5 (o v1 … v5). Vigente: triage_v2
# (elegida con la comparación del 19/11/2026, provisional hasta M1L5; ver prompts/CHANGELOG.md).
# Se puede elegir otra en cada ejecución con:  python -m src.main --prompt v4 "..."
PROMPT_VERSION=triage_v2
